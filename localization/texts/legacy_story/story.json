{
  "feature": "story",
  "entries": {
    "00fb4b34240a": {
      "zh_CN": "这木头纹路真好看。"
    },
    "01e73b519785": {
      "zh_CN": "大家今晚有果子吃了。"
    },
    "1098885d8bc4": {
      "zh_CN": "第一只陶罐烧好了，真结实。"
    },
    "19da236361a9": {
      "zh_CN": "陶罐能装好多水。"
    },
    "1c5a6da78a1d": {
      "zh_CN": "这把石器真顺手！"
    },
    "206fd765d9bb": {
      "zh_CN": "新衣服好软！"
    },
    "3d319fe1d45a": {
      "zh_CN": "够全部落吃三天。"
    },
    "401fe31e5c63": {
      "zh_CN": "编织架织出的第一件衣服，真暖和。"
    },
    "4f585717a301": {
      "zh_CN": "丰收的季节到了。"
    },
    "5191b45dc26b": {
      "zh_CN": "我也想捏一个！"
    },
    "62d2b56b875f": {
      "zh_CN": "我一口气吃了三个！"
    },
    "630787b71b51": {
      "zh_CN": "这果子晒干能存一冬。"
    },
    "6cafb768113b": {
      "zh_CN": "烤得真香！"
    },
    "70989e419e01": {
      "zh_CN": "好工具才有好猎手。"
    },
    "821465893940": {
      "zh_CN": "阿石叔叔好厉害！"
    },
    "8bcf3a92ffde": {
      "zh_CN": "磨得真快，能削木头了。"
    },
    "9938ad98918c": {
      "zh_CN": "火塘生起来了，烤得真香！"
    },
    "9b65931d4cc8": {
      "zh_CN": "果子熟得正好。"
    },
    "9d29a508769c": {
      "zh_CN": "老骨头总算暖和了。"
    },
    "a6026c05c492": {
      "zh_CN": "有了陶罐，粮食不怕潮了。"
    },
    "acacf6a8d0df": {
      "zh_CN": "热乎的吃了不生病。"
    },
    "b2d6e32fa15d": {
      "zh_CN": "木工场开工了，部落要盖大屋了！"
    },
    "c1ec39c43cca": {
      "zh_CN": "石匠台的第一把石器，真顺手！"
    },
    "c35e2ba25400": {
      "zh_CN": "火塘边香喷喷的。"
    },
    "c9cb2398a9ee": {
      "zh_CN": "今天收获不错！"
    },
    "c9d64f961723": {
      "zh_CN": "甜甜的，还想要！"
    },
    "cc026ac03cce": {
      "zh_CN": "第一次下陷阱就有收获！"
    },
    "ccdab374095a": {
      "zh_CN": "带上果子，打猎不饿肚子。"
    },
    "ce882d980c34": {
      "zh_CN": "冬天不怕冷了。"
    },
    "f043ceacdebc": {
      "zh_CN": "大屋里终于有凳子坐了。"
    },
    "fc0270e5c629": {
      "zh_CN": "篝火边有吃的了，大家都很高兴！"
    }
  }
}

# 复制成 server/.env 再改。所有配置都是 TRIBE_ 开头的环境变量，见 app/config.py。
# 运行环境：dev / test / prod。prod 会关闭 mock 登录和 /docs，并要求换掉 TOKEN_PEPPER。
TRIBE_ENV=dev
# 本地默认 SQLite；正式环境用 PostgreSQL：
# TRIBE_DATABASE_URL=postgresql+psycopg://tribe:请改密码@db:5432/tribe
TRIBE_DATABASE_URL=sqlite:///./tribe.db
# token 哈希用的 pepper，正式环境必须换成随机长串（python -c "import secrets;print(secrets.token_urlsafe(48))"）
TRIBE_TOKEN_PEPPER=dev-pepper-change-me
TRIBE_TOKEN_TTL_DAYS=30
TRIBE_TOKEN_RENEW_DAYS=7
TRIBE_RATE_PLAYER_PER_MIN=120
TRIBE_RATE_IP_PER_MIN=600
TRIBE_MAX_BODY_BYTES=98304
TRIBE_BACKUPS_RECENT=3
TRIBE_BACKUPS_DAILY_DAYS=30
TRIBE_LOG_LEVEL=INFO
TRIBE_LOG_JSON=true
# 放在反向代理后面时打开，用 X-Forwarded-For 取真实 IP
TRIBE_TRUST_FORWARDED=false

# 云存档：解压后的存档上限（字节）
TRIBE_SAVE_MAX_RAW_BYTES=1048576
# 存档合理性检查（只标记账号、移出排行榜，不拒绝存档）：允许增长 = burst + 每小时速率 × 间隔小时数
TRIBE_PLAUS_LEVEL_BURST=3
TRIBE_PLAUS_LEVEL_PER_HOUR=8
TRIBE_PLAUS_AMBER_BURST=500
TRIBE_PLAUS_AMBER_PER_HOUR=400
TRIBE_PLAUS_SHELLS_BURST=5000
TRIBE_PLAUS_SHELLS_PER_HOUR=20000

extends SceneTree
## Real merge drops, delayed discovery, save restoration, wages and display copy.
var failures := 0
var g
var replay
var main
var ui
func _initialize() -> void: run.call_deferred()
func check(ok: bool, label: String) -> void:
	print(("PASS " if ok else "FAIL ") + label)
	if not ok: failures += 1
func fresh() -> void:
	replay.executing = true
	replay.meta = {}; replay.seq = 0; replay.base = 0; replay.pending = []; replay.inflight = {}
	replay.clock = 1794240000; g.simulation_time = replay.clock
	g.new_game(); g.random_seed = "coin-discovery"; g.random_streams = {}
	replay.advance(); replay._canonicalize_live(); replay.executing = false
	g.clear_presentations()
func free_board() -> void:
	for i in g.board.size(): g.board[i] = {"id": "", "lock": 0}
	replay.meta["onboarding"]["step"] = g.rules.onboarding.stage_index("free_level2")
func find_item(id: String, exclude := -1) -> int:
	for i in g.board.size():
		if i != exclude and str(g.board[i]["id"]) == id and int(g.board[i]["lock"]) == 0: return i
	return -1
func merge_pair(id: String) -> int:
	var a := find_item(id); var b := find_item(id, a)
	if a < 0 or b < 0: return -1
	var result: Dictionary = replay.perform("drop", {"from": a, "to": b}, replay.clock)
	return b if str(result.get("kind", "")) == "merge" else -1
func has_text(node: Node, needle: String) -> bool:
	if node is Label and needle in node.text: return true
	for child in node.get_children():
		if has_text(child, needle): return true
	return false
func sample_merges(tutorial: bool) -> Dictionary:
	fresh(); free_board(); g.tutorial_on = tutorial
	var drops := 0; var wrong_level := 0; var fragments: Array = []
	replay.executing = true
	for _i in 20000:
		g.board[0]["id"] = "fruit_1"; g.board[1]["id"] = "fruit_1"
		var result: Dictionary = replay._reducer.dispatch("drop", {"from": 0, "to": 1})
		if result.get("kind", "") != "merge": check(false, "sampling uses successful real merges"); break
		for cell in g.board:
			if Data.chain(str(cell["id"])) == "shell" and str(cell["id"]) != "shell_2": wrong_level += 1
			if str(cell["id"]) == "shell_2":
				drops += 1
				if fragments.size() < 2: fragments.append(cell.duplicate(true))
			cell["id"] = ""
		g.clear_presentations()
	replay.executing = false
	# Retain two level-two items genuinely generated by the sampled merges.
	for i in fragments.size(): g.board[10 + i] = fragments[i]
	return {"drops": drops, "wrong_level": wrong_level, "snapshot": replay.snapshot()}
func run() -> void:
	g = root.get_node("G"); replay = root.get_node("Replay"); ui = load("res://scripts/ui/UI.gd")
	for node in root.get_children(): node.set_process(false)
	fresh()
	replay.meta["onboarding"]["step"] = g.rules.onboarding.stage_index("merge1")
	for pair in [[23, 30], [30, 31], [31, 32]]: replay.perform("drop", {"from": pair[0], "to": pair[1]}, replay.clock)
	check(g.rules.onboarding.count("shell_2") == 0, "开局生产器合成不掉金币，保持初始解锁顺序")
	var tutorial := sample_merges(true)
	var normal := sample_merges(false)
	var rate := float(tutorial["drops"]) / 20000.0
	print("SAMPLED coin: tutorial=", tutorial["drops"], "/20000 normal=", normal["drops"], "/20000 rate=", rate * 100.0, "%")
	check(rate > 0.045 and rate < 0.055 and tutorial["drops"] == normal["drops"] and tutorial["wrong_level"] == 0 and normal["wrong_level"] == 0, "去掉引导后仍以5%概率掉落2级金币")
	replay.restore(tutorial["snapshot"])
	var main = load("res://main.tscn").instantiate(); root.add_child(main); main.show_screen("board", true)
	var p: Dictionary = g.rules.onboarding.progress()
	# Old saved discovery markers must never bring back the retired overlay.
	p["coin_made"] = true; p["coin_drops"] = 2; p["coin_done"] = false
	var quiet := true
	for level in [1, 2, 3, 4, 5, 8]:
		g.level = level; main._guide._refresh()
		quiet = quiet and not main._guide.visible
	check(quiet, "1至8级均不出现香蕉收取引导，旧发现标记也不触发")
	g.level = 2
	var target := merge_pair("shell_2")
	g.board[20] = {"id": "shell_3", "lock": 1}
	main._guide._refresh()
	check(target >= 0 and main._guide.allows_drop(target, 20) and not main._guide.visible, "合出香蕉后仍可自由拖向藤蔓，没有收取蒙层抢操作")
	var unlocked: Dictionary = replay.perform("drop", {"from": target, "to": 20}, replay.clock)
	check(unlocked.get("kind", "") == "merge" and g.board[20]["id"] == "shell_4" and g.board[20]["lock"] == 0 and g.shells == 0, "香蕉可先用于合成解锁，余额不自动增加")
	var got: Dictionary = replay.perform("tap", {"cell": 20}, replay.clock)
	check(got.get("kind", "") == "collect" and g.shells == Data.value_of("shell_4"), "玩家仍能自行收取香蕉")
	var before: int = g.shells
	replay.perform("tap", {"cell": 20}, replay.clock)
	check(g.shells == before, "重复收取不会重复发钱")
	p = g.rules.onboarding.progress()
	g.board[0]["id"] = "shell_4"; p["coin_placed"] = true
	p["step"] = g.rules.onboarding.stage_index("coin")
	main._guide._refresh()
	check(not main._guide.visible, "旧存档停在已删除步骤时也不出现蒙层")
	replay.perform("tick", {}, replay.clock); main._guide._refresh()
	check(str(g.rules.onboarding.stage()["key"]) == "free_third" and g.board[0]["id"] == "shell_4" and g.shells == before and g.rules.onboarding.progress()["completed"].has("coin"), "旧引导自动跳过，香蕉、余额及后续步骤保留")
	var snap: Dictionary = replay.snapshot(); replay.restore(snap)
	main._guide._refresh()
	check(not main._guide.visible and str(g.rules.onboarding.stage()["key"]) == "free_third", "恢复后不重新弹出已删除的收取引导")
	g.tutorial_on = false; g.seen_tutorial = true; g.level = 5; g.tips_seen = {}; g.stash = ["fruit_1"]
	main._guide._refresh(); main.tips._auto()
	check(not main._guide.visible and g.tips_seen.get("stash", false), "新手结束后不补弹香蕉引导，也不阻塞其他提示")
	await process_frame
	main.free(); g.main = null
	await process_frame
	quit(1 if failures else 0)

class_name PriceBook
extends RefCounted
## Resolved server catalog. No price formula or commercial constants belong here.
static var catalog: Dictionary = {}

static func _static_init() -> void:
	if OS.has_feature("web"):
		var raw = JavaScriptBridge.eval("JSON.stringify(window.tribeEconomyCatalog || {})", true)
		install(JSON.parse_string(str(raw)))
	elif FileAccess.file_exists("res://server/public/catalog_CN.json"):
		# Native development/tests use a snapshot generated by the server compiler.
		# server/* is excluded from exported clients.
		install(JSON.parse_string(FileAccess.get_file_as_string("res://server/public/catalog_CN.json")))
	elif FileAccess.file_exists("user://economy-catalog.json"):
		install(JSON.parse_string(FileAccess.get_file_as_string("user://economy-catalog.json")))

static func install(value) -> bool:
	if not value is Dictionary or int(value.get("schema", 0)) != 1 or not value.get("items") is Dictionary or not value.get("documents") is Dictionary: return false
	if str(value.get("version", "")) == "" or not value.get("energy", {}).get("prices") is Array: return false
	catalog = value.duplicate(true)
	return true

static func ready() -> bool:
	return not catalog.is_empty()

static func document(path: String):
	return catalog.get("documents", {}).get(path.get_file().get_basename())

static func item(id: String) -> Dictionary:
	return catalog.get("items", {}).get(id, {})

static func value(id: String) -> float:
	return float(item(id).get("value", 0))

static func difficulty(id: String) -> float:
	return float(item(id).get("difficulty", 0))

static func price(id: String, currency := "amber") -> int:
	return int(item(id).get(currency, 0))

static func energy_price(bought: int) -> int:
	var prices: Array = catalog.get("energy", {}).get("prices", [])
	return int(prices[clampi(bought, 0, prices.size() - 1)]) if not prices.is_empty() else -1

static func energy_amount() -> int:
	return int(catalog.get("energy", {}).get("amount", 0))

static func product_text(product: String) -> String:
	return str(catalog.get("products", {}).get(product, {}).get("price_str", "…"))

static func reward_value(rewards: Array) -> float:
	var total := 0.0
	for rw in rewards:
		if not rw is Array or rw.size() < 2: continue
		var entry := item(str(rw[0]))
		var kind := str(entry.get("kind", ""))
		var units: Dictionary = catalog.get("units", {})
		var physical: bool = rw.size() > 2 and str(rw[2]) in ["item", "physical"]
		var unit := float(units[kind]) if units.has(kind) and not physical else float(entry.get("value", 0))
		total += float(rw[1]) * unit
	return total

static func order_shell_per_value() -> float:
	return float(catalog.get("orders", {}).get("shell_per_value", 0))
